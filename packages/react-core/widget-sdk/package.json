{
  "name": "@wellsfargo-starui/widget-sdk",
  "version": "1.0.0",
  "description": "Star Widget SDK — React hooks, WidgetHost, and extensibility over @wellsfargo-starui/widget",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@wellsfargo-starui/shared-types": "*",
    "@tanstack/react-query": "^5.80.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "dependencies": {
    "@wellsfargo-starui/host-config": "*",
    "@wellsfargo-starui/widget": "*",
    "@wellsfargo-starui/widget-browser": "*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.2",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "star",
    "widget",
    "sdk",
    "useWidget",
    "platform-adapter"
  ],
  "author": "Star Development Team",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ]
}
