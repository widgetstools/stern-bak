{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "ui/dist/**",
        "widget-sdk/dist/**",
        "host-wrapper-react/dist/**",
        "workspace-setup-react/dist/**",
        "host-data-react/dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [
        "junit.xml",
        "coverage/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build",
        "^build"
      ]
    }
  }
}
