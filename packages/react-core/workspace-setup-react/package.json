{
  "name": "@wellsfargo-starui/workspace-setup-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@wellsfargo-starui/design-system": "*",
    "@wellsfargo-starui/engine": "*",
    "@wellsfargo-starui/icons-svg": "*",
    "@wellsfargo-starui/openfin-platform": "*",
    "@wellsfargo-starui/ui": "*",
    "lucide-react": "^0.554.0"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "sideEffects": [
    "*.css"
  ]
}
