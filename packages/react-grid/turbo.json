{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "grid/dist/**",
        "config-browser/dist/**",
        "widgets-react/dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [
        "junit.xml",
        "coverage/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build",
        "^build"
      ]
    }
  }
}
