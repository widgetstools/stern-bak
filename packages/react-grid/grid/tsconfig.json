{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@wellsfargo-starui/grid": ["./src/index.ts"],
      "@wellsfargo-starui/grid/customizer": ["./src/customizer/index.ts"],
      "@wellsfargo-starui/core": ["../../core/engine/src/index.ts"],
      "@wellsfargo-starui/types": ["../../types/types/src/index.ts"],
      "@wellsfargo-starui/core/host": ["../../core/host/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../../types/types" },
    { "path": "../../core/host" },
    { "path": "../../core/engine" }
  ]
}
