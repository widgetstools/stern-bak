{
  "name": "@wellsfargo-starui/config-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wellsfargo-starui/design-system": "*",
    "@wellsfargo-starui/engine": "*",
    "@wellsfargo-starui/host-config": "*",
    "@wellsfargo-starui/openfin-platform": "*",
    "@wellsfargo-starui/ui": "*",
    "lucide-react": "^0.554.0"
  },
  "peerDependencies": {
    "@wellsfargo-starui/grid": "*",
    "ag-grid-community": "^35.1.0",
    "ag-grid-enterprise": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "peerDependenciesMeta": {
    "@wellsfargo-starui/grid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wellsfargo-starui/grid": "*",
    "ag-grid-enterprise": "35.1.0",
    "jsdom": "^29.0.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
  },
  "sideEffects": [
    "*.css"
  ]
}
