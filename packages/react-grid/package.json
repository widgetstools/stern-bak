{
  "name": "@wellsfargo-starui/grid",
  "version": "0.1.0",
  "private": true,
  "description": "MarketsGrid + grid customizer + config browser + React widgets — merged product surface. Consolidates grid, config-browser, widgets-react.",
  "type": "module",
  "main": "./grid/dist/index.js",
  "module": "./grid/dist/index.js",
  "types": "./grid/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./grid/dist/index.d.ts",
      "import": "./grid/dist/index.js",
      "require": "./grid/dist/index.js"
    },
    "./customizer": {
      "types": "./grid/dist/customizer/index.d.ts",
      "import": "./grid/dist/customizer/index.js"
    },
    "./styles.css": "./grid/dist/widget/styles/marketsGrid.css",
    "./styles/core.css": "./grid/dist/widget/styles/marketsGrid-core.css",
    "./styles/chrome.css": "./grid/dist/widget/styles/marketsGrid-chrome.css",
    "./runtime/openfin": {
      "types": "./grid/dist/runtime/openFin.d.ts",
      "import": "./grid/dist/runtime/openFin.js"
    },
    "./config-browser": {
      "types": "./config-browser/dist/index.d.ts",
      "import": "./config-browser/dist/index.js",
      "require": "./config-browser/dist/index.js"
    },
    "./config-browser/icons": {
      "types": "./config-browser/dist/icons.d.ts",
      "import": "./config-browser/dist/icons.js"
    },
    "./widgets": {
      "types": "./widgets-react/dist/index.d.ts",
      "import": "./widgets-react/dist/index.js",
      "require": "./widgets-react/dist/index.js"
    },
    "./widgets/markets-grid-container": {
      "types": "./widgets-react/dist/container/markets-grid-container/index.d.ts",
      "import": "./widgets-react/dist/container/markets-grid-container/index.js"
    },
    "./widgets/provider-editor": {
      "types": "./widgets-react/dist/container/provider-editor/index.d.ts",
      "import": "./widgets-react/dist/container/provider-editor/index.js"
    },
    "./widgets/data-provider-selector": {
      "types": "./widgets-react/dist/container/data-provider-selector/index.d.ts",
      "import": "./widgets-react/dist/container/data-provider-selector/index.js"
    },
    "./widgets/hosted": {
      "types": "./widgets-react/dist/hosted/index.d.ts",
      "import": "./widgets-react/dist/hosted/index.js"
    },
    "./perspective": {
      "types": "./perspective-grid/dist/index.d.ts",
      "import": "./perspective-grid/dist/index.js",
      "require": "./perspective-grid/dist/index.js"
    }
  },
  "files": [
    "grid/dist",
    "config-browser/dist",
    "widgets-react/dist",
    "perspective-grid/dist"
  ],
  "scripts": {
    "build": "rimraf grid/dist grid/tsconfig.tsbuildinfo config-browser/dist config-browser/tsconfig.tsbuildinfo widgets-react/dist widgets-react/tsconfig.tsbuildinfo perspective-grid/dist perspective-grid/tsconfig.tsbuildinfo && tsc --project perspective-grid/tsconfig.json && tsc --project grid/tsconfig.build.json && node grid/scripts/copy-assets.mjs && tsc --project config-browser/tsconfig.build.json && node config-browser/scripts/copy-assets.mjs && tsc --project widgets-react/tsconfig.json",
    "typecheck": "tsc --noEmit --project perspective-grid/tsconfig.json && tsc --noEmit --project grid/tsconfig.json && tsc --noEmit --project config-browser/tsconfig.json && tsc --noEmit --project widgets-react/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "soak:value-getter": "npx cross-env SOAK=1 NODE_OPTIONS=--expose-gc vitest run widgets-react/src/container/markets-grid-container/valueGetter.soak.test.ts --no-file-parallelism"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.0",
    "@wellsfargo-starui/design-system": "*",
    "ag-grid-community": "^35.1.0",
    "ag-grid-enterprise": "^35.1.0",
    "ag-grid-react": "^35.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "//dependencies-registry-notes": "@perspective-dev/client pinned to 4.5.2 (not latest), the same pin @wellsfargo-starui/data carries: the window-side row engine in perspective-grid/ encodes behaviour measured against 4.5.2 specifically — the uncatchable wasm borrow error on deleting a View mid-read, `table.update()` coercing rather than rejecting a mistyped value, `not()` compiling clean but evaluating wrong inside and/or/if, and row 0 of a grouped View being the level total. Both packages must move together, and only after re-running that measurement pass.",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@perspective-dev/client": "4.5.2",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@wellsfargo-starui/core": "*",
    "@wellsfargo-starui/data": "*",
    "@wellsfargo-starui/design-system": "*",
    "@wellsfargo-starui/openfin": "*",
    "@wellsfargo-starui/react": "*",
    "@wellsfargo-starui/types": "*",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.554.0"
  },
  "devDependencies": {
    "@perspective-dev/client": "4.5.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "~4.5.2",
    "@wellsfargo-starui/design-system": "*",
    "ag-grid-community": "35.1.0",
    "ag-grid-enterprise": "35.1.0",
    "ag-grid-react": "35.1.0",
    "jsdom": "^29.0.2",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
  },
  "sideEffects": [
    "*.css"
  ]
}
