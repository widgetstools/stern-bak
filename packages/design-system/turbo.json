{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../react-core/ui/src/**",
        "../react-grid/grid/src/**",
        "../react-grid/widgets-react/src/**",
        "../react-grid/config-browser/src/**",
        "../react-core/workspace-setup-react/src/**",
        "../react-core/host-data-react/src/**"
      ],
      "outputs": [
        "design-system/dist/**",
        "icons-svg/dist/**"
      ]
    }
  }
}
