{
  "name": "@wellsfargo-starui/platform",
  "version": "0.1.0",
  "private": true,
  "description": "MarketsUI platform \u2014 modular Markets UI monorepo.",
  "packageManager": "npm@10.9.0",
  "//workspaces-note": "Angular buckets (angular-ui, angular-grid, angular-core) and host-data-angular are intentionally excluded \u2014 the build pipeline targets React + shared only. Data members are listed individually to omit host-data-angular.",
  "workspaces": [
    "packages/design-system/*",
    "packages/react-ui/*",
    "packages/react-grid/*",
    "packages/data/host-config",
    "packages/data/host-data",
    "packages/data/host-data-react",
    "packages/openfin/*",
    "packages/react-core/*",
    "packages/shared/*",
    "tools/mcp-scaffold",
    "e2e-openfin"
  ],
  "scripts": {
    "install:apps": "node scripts/install-apps.mjs",
    "install:all": "npm run bootstrap",
    "build:packages": "node scripts/ensure-workspace-links.mjs && npx turbo build --filter=!./apps/** --concurrency=50%",
    "build:apps": "npm --prefix apps run build",
    "build:consumer": "npm run build:packages && node scripts/propagate.mjs --no-build && npm run install:apps",
    "build:all": "npm run build:consumer && npm run build:apps",
    "build": "npm run build:consumer",
    "typecheck:packages": "npx turbo typecheck --filter=!./apps/**",
    "typecheck:apps": "npm --prefix apps run typecheck",
    "typecheck:consumer": "npm run build:packages && npm run install:apps && npm run typecheck:apps",
    "typecheck": "npm run typecheck:consumer",
    "test:packages": "npx turbo test --filter=!./apps/**",
    "test": "npm run test:packages",
    "test:coverage": "npx turbo test --filter=!./apps/** -- --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "soak:value-getter": "npm run soak:value-getter -w @wellsfargo-starui/widgets-react",
    "check:source-aliases": "node scripts/check-source-aliases.mjs",
    "check:tarballs": "npm run build:packages && node scripts/propagate.mjs --check-only --no-install --no-build",
    "check:ds-tokens": "tsx tools/scripts/check-ds-tokens.ts",
    "check:no-native-select": "tsx tools/scripts/check-react-apps-no-native-select.ts",
    "check:design-system-deps": "tsx tools/scripts/check-design-system-deps.ts",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" --fix",
    "lint:all": "npm run lint && npm run check:deps && npm run check:no-native-select && npm run check:design-system-deps",
    "verify:consumer": "npm run build:packages && node scripts/propagate.mjs && npm run install:apps && npm run build:apps",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:container": "playwright test -c playwright.container.config.ts",
    "dev": "npm run dev:demo-react",
    "dev:demo-react": "npm --prefix apps run dev -w @wellsfargo-starui/demo-react",
    "dev:demo-configservice-react": "npm --prefix apps run dev -w @wellsfargo-starui/demo-configservice-react",
    "dev:tutorial-basic": "npm --prefix apps run dev -w @wellsfargo-starui/tutorial-basic",
    "dev:tutorial-mockdata-provider": "npm --prefix apps run dev -w @wellsfargo-starui/tutorial-mockdata-provider",
    "dev:tutorial-dataprovider-editor": "npm --prefix apps run dev -w @wellsfargo-starui/tutorial-dataprovider-editor",
    "dev:tutorial-stomp": "npm --prefix apps run dev -w @wellsfargo-starui/tutorial-stomp",
    "dev:browser-blotter": "npm --prefix apps run dev -w @wellsfargo-starui/e2e-browser-blotter",
    "dev:openfin-workspace": "npm --prefix apps run dev -w @wellsfargo-starui/e2e-openfin-workspace",
    "dev:openfin:openfin-workspace": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:openfin-workspace\" \"wait-on http://localhost:5181 && node tools/scripts/launch-openfin.mjs http://localhost:5181/platform/manifest.fin.json\"",
    "dev:markets-ui-react-reference": "npm --prefix apps run dev -w @wellsfargo-starui/markets-ui-react-reference",
    "dev:star-demo": "npm --prefix apps run dev -w @wellsfargo-starui/star-demo",
    "dev:markets-grid-lab": "npm --prefix apps run dev -w @wellsfargo-starui/markets-grid-lab",
    "dev:design-system": "npm --prefix apps run dev -w @wellsfargo-starui/design-system-demo",
    "dev:demo-stomp-markets-grid": "npm --prefix apps run dev -w @wellsfargo-starui/demo-stomp-markets-grid",
    "dev:stomp-marketsgrid-minimal": "npm --prefix apps run dev -w @wellsfargo-starui/stomp-marketsgrid-minimal",
    "dev:platform-hooks-demo": "npm --prefix apps run dev -w @wellsfargo-starui/platform-hooks-demo",
    "dev:stomp": "npm --prefix apps run dev -w @wellsfargo-starui/stomp-view-server",
    "dev:demo": "npm run dev:demo-react",
    "dev:openfin": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:demo-react -- --no-open\" \"wait-on http://localhost:5190 && node tools/scripts/launch-openfin.mjs http://localhost:5190/openfin/manifest.json\"",
    "dev:openfin:markets-react": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:markets-ui-react-reference -- --no-open\" \"wait-on http://localhost:5174 && node tools/scripts/launch-openfin.mjs http://localhost:5174/platform/manifest.fin.json\"",
    "dev:openfin:demo-stomp-markets-grid": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:demo-stomp-markets-grid -- --no-open\" \"wait-on http://localhost:5210 && node apps/demos/demo-stomp-markets-grid/launch.mjs\"",
    "star-demo": "concurrently -k -n vite,openfin -c cyan,magenta \"npm run dev:star-demo -- --no-open\" \"wait-on http://localhost:5175 && node apps/demos/star-demo/launch.mjs\"",
    "launch:openfin": "node tools/scripts/launch-openfin.mjs",
    "e2e:openfin": "npm run test:e2e -w @wellsfargo-starui/e2e-openfin",
    "test:e2e:openfin": "npm run test:e2e -w @wellsfargo-starui/e2e-openfin",
    "test:e2e:openfin:vitest-legacy": "npm run test:e2e -w @wellsfargo-starui/e2e-openfin-vitest",
    "bootstrap": "node scripts/bootstrap.mjs",
    "propagate": "node scripts/propagate.mjs",
    "pack:mcp": "node scripts/pack-mcp-scaffold.mjs",
    "verify:apps": "node scripts/verify-apps.mjs",
    "check:deps": "node scripts/check-package-cycles.mjs",
    "check:deps:strict": "node scripts/check-package-cycles.mjs --strict",
    "clean": "rimraf -g node_modules apps/node_modules packages/*/*/node_modules packages/*/*/dist apps/demos/*/node_modules .turbo",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@openfin/node-adapter": "43.101.2",
    "@playwright/test": "1.59.1",
    "@wellsfargo-starui/design-system": "*",
    "@wellsfargo-starui/icons-svg": "*",
    "@wellsfargo-starui/shared-types": "*",
    "@wellsfargo-starui/types": "*",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.15.0",
    "postcss": "^8.5.9",
    "rimraf": "^6.0.1",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.6.0",
    "vitest": "^4.1.4",
    "wait-on": "^8.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.4",
    "@rollup/rollup-darwin-x64": "4.60.4",
    "@rollup/rollup-linux-arm64-gnu": "4.60.4",
    "@rollup/rollup-linux-x64-gnu": "4.60.4",
    "@rollup/rollup-win32-arm64-msvc": "4.60.4",
    "@rollup/rollup-win32-x64-msvc": "4.60.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@openfin/core": "43.101.2",
    "esbuild": "0.28.0",
    "hono": "^4.12.20",
    "dompurify": "^3.4.8"
  }
}
