{
  "name": "@wellsfargo-starui/platform",
  "version": "0.1.0",
  "private": true,
  "description": "MarketsUI platform \u2014 modular Markets UI monorepo.",
  "packageManager": "npm@10.9.0",
  "//workspaces-note": "The angular-* buckets were deleted, and host-data-angular (the last Angular scaffold) was deleted on feature/simplify \u2014 the build pipeline targets the React + types/core buckets only.",
  "workspaces": [
    "packages/design-system",
    "packages/react-grid",
    "packages/data",
    "packages/openfin",
    "packages/react-core",
    "packages/types",
    "packages/core"
  ],
  "scripts": {
    "install:all": "npm install && npm run build:packages",
    "setup:apps": "npm run install:all && npm run pack:npm && (cd apps && npm install && npm run setup:tarball && cd ..)",
    "app": "node scripts/run-app.mjs",
    "build:packages": "node scripts/ensure-workspace-links.mjs && npx turbo build --concurrency=50% && node scripts/gen-consumer-tsconfig.mjs",
    "build": "npm run build:packages",
    "typecheck:packages": "npx turbo typecheck",
    "typecheck": "npm run build:packages && npm run typecheck:packages",
    "test:packages": "npx turbo test",
    "test": "npm run test:packages",
    "test:coverage": "node scripts/run-test-coverage.mjs",
    "bench:ssrm": "node --expose-gc --max-old-space-size=8192 scripts/bench-ssrm.mjs",
    "bench:ssrm:sweep": "node scripts/bench-ssrm-sweep.mjs",
    "check:coverage": "node scripts/check-package-coverage.mjs",
    "check:rtl": "node scripts/check-react-testing-library.mjs",
    "check:coverage:report": "node scripts/check-package-coverage.mjs --report",
    "check:source-aliases": "node scripts/check-source-aliases.mjs",
    "check:ds-tokens": "tsx tools/scripts/check-ds-tokens.ts",
    "check:design-system-deps": "tsx tools/scripts/check-design-system-deps.ts",
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" --fix",
    "lint:all": "npm run lint && npm run check:deps && npm run check:design-system-deps && npm run check:rtl",
    "check:deps": "node scripts/check-package-cycles.mjs",
    "check:complexity": "node scripts/check-complexity-budget.mjs",
    "verify:external": "node scripts/verify-external-consumers.mjs",
    "check:deps:strict": "node scripts/check-package-cycles.mjs --strict",
    "clean": "rimraf -g node_modules packages/*/*/node_modules packages/*/*/dist .turbo",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@wellsfargo-starui/design-system": "*",
    "@wellsfargo-starui/types": "*",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.15.0",
    "postcss": "^8.5.9",
    "rimraf": "^6.0.1",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.6.0",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.60.4",
    "@rollup/rollup-darwin-x64": "4.60.4",
    "@rollup/rollup-linux-arm64-gnu": "4.60.4",
    "@rollup/rollup-linux-x64-gnu": "4.60.4",
    "@rollup/rollup-win32-arm64-msvc": "4.60.4",
    "@rollup/rollup-win32-x64-msvc": "4.60.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@openfin/core": "43.101.2",
    "esbuild": "0.28.0",
    "hono": "^4.12.20",
    "dompurify": "^3.4.8"
  }
}
