{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "react": [
        "../../../node_modules/@types/react"
      ],
      "react/*": [
        "../../../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../../../node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../../../node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
