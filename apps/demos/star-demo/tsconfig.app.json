{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./node_modules/.tmp/tsc-out",
    "types": [
      "./src/types/fin",
      "./src/types/svg"
    ],
    "paths": {
      "react": [
        "../../../node_modules/@types/react"
      ],
      "react/*": [
        "../../../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../../../node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../../../node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
