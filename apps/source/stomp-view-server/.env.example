# stomp-view-server runtime config. Copy to .env to override; the values here
# mirror the built-in defaults in src/config.ts.
PORT=8081
# Row shape: slim (default, ~1.1 KB top-level primitives) or wide (~8.5 KB nested)
ROW_PROFILE=slim
# Snapshot size delivered per subscriber, clamped to [MIN, MAX]. Clients may
# request a count in range via the `snapshot-rows` STOMP header.
DEFAULT_SNAPSHOT_ROWS=20000
MIN_SNAPSHOT_ROWS=1000
MAX_SNAPSHOT_ROWS=20000
SWEEP_ROWS_PER_SEC=60000
# LIVE_MODE=sparse
# DEBUG=1
