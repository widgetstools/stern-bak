# Listener. 8081 matches the provider configs already in this repo.
# Note: apps/source/stomp-view-server also defaults to 8081 — run one or
# the other, or move this one.
PORT=8081
HOST=0.0.0.0

# debug | info | warn | error | silent
LOG_LEVEL=info

# Phase-1 synthetic book. Replaced by the DuckDB-backed corpus in a later phase.
BOOK_SCALE=1
TICK_ROWS=200
TICK_INTERVAL_MS=100
SEED=20260907
