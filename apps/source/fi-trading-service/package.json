{
  "name": "@wellsfargo-starui/fi-trading-service",
  "private": true,
  "version": "1.0.0",
  "description": "Fixed-income trading data service. Serves realistic positions/trades/security-master/market-data/orders/tax-lots over STOMP-on-WebSocket, backed by a DuckDB + Parquet corpus.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=lcov"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.22.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16"
  },
  "license": "ISC"
}
