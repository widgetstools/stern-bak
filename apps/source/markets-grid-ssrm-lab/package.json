{
  "name": "@wellsfargo-starui/markets-grid-ssrm-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run precheck && vite build",
    "precheck": "node ../../../scripts/validateTailwindSetup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=lcov"
  },
  "dependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-enterprise": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "lucide-react": "^0.554.0",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "~4.5.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.9",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "~7.3.2"
  }
}
