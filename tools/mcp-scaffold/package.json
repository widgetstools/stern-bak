{
  "name": "@wellsfargo-starui/mcp-scaffold",
  "version": "0.3.0",
  "description": "StarUI Platform MCP — scaffold apps, wire STOMP, diagnose empty grids, OpenFin routes",
  "type": "module",
  "bin": {
    "starui-mcp-scaffold": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "bundled-libs",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
