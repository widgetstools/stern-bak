import { useState } from 'react';
import { Button } from '@wellsfargo-starui/ui';
import { HostedMarketsGrid } from '@wellsfargo-starui/widgets-react/hosted';
import { DataProviderEditor } from '@wellsfargo-starui/widgets-react/provider-editor';
import { getPlatform } from './platformBootstrap';

type Tab = 'grid' | 'editor';

/** Hosted grid + provider editor — dataprovider-editor tutorial shape. */
export function App() {
  const [tab, setTab] = useState<Tab>('grid');
  const { configManager } = getPlatform();

  return (
    <div className="flex h-screen flex-col bg-[color:var(--ds-surface-ground)]">
      <header className="flex h-12 items-center gap-2 border-b border-[color:var(--ds-border-primary)] px-4">
        <span className="font-mono text-[13px]">{{appName}}</span>
        <Button size="sm" variant={tab === 'grid' ? 'default' : 'outline'} onClick={() => setTab('grid')}>Grid</Button>
        <Button size="sm" variant={tab === 'editor' ? 'default' : 'outline'} onClick={() => setTab('editor')}>Providers</Button>
      </header>
      <main className="min-h-0 flex-1 overflow-hidden">
        {tab === 'grid' ? (
          <HostedMarketsGrid
            gridId="{{gridId}}"
            componentName="Hosted Blotter"
            defaultInstanceId="{{gridId}}"
            withStorage
            configManager={configManager}
            theme="auto"
            {{#each gridPropsLines}}
            {{{this}}}
            {{/each}}
          />
        ) : (
          <DataProviderEditor userId="dev1" />
        )}
      </main>
    </div>
  );
}
