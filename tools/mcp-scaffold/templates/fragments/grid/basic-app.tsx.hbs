/**
 * Basic MarketsGrid shell — static bond inventory, localStorage profiles.
 * All chrome uses @wellsfargo-starui/ui (shadcn). Surfaces use design-system tokens only.
 * AG Grid theme: MarketsGrid → useGridTheme() → agGridDarkTheme / agGridLightTheme.
 */
import { useCallback, useMemo, useState } from 'react';
import {
  MarketsGrid,
  createMarketsGridLocalStorageStorage,
} from '@wellsfargo-starui/grid';
import { applyTheme, getTheme } from '@wellsfargo-starui/design-system';
import { Button, Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@wellsfargo-starui/ui';
import { Sun, Moon } from 'lucide-react';
import { buildBondInventory } from './mockBonds';
import { bondColumnDefs, bondDefaultColDef } from './bondColumns';

const storage = createMarketsGridLocalStorageStorage();

export function App() {
  const [theme, setTheme] = useState<'dark' | 'light'>(() => getTheme().theme as 'dark' | 'light');
  const [rows] = useState(() => buildBondInventory(120));
  const isDark = theme === 'dark';

  const handleToggleTheme = useCallback(() => {
    const next: 'dark' | 'light' = isDark ? 'light' : 'dark';
    applyTheme({ theme: next });
    setTheme(next);
  }, [isDark]);

  const tooltipLabel = useMemo(
    () => (isDark ? 'Switch to light mode' : 'Switch to dark mode'),
    [isDark],
  );

  return (
    <div className="flex h-screen w-screen flex-col overflow-hidden bg-[color:var(--ds-surface-ground)] text-[color:var(--ds-text-primary)]">
      <header className="flex h-[52px] shrink-0 items-center justify-between border-b border-[color:var(--ds-border-primary)] bg-[color:var(--ds-surface-primary)] px-4">
        <span className="font-mono text-[13px] font-semibold">{{appName}}</span>
        <TooltipProvider delayDuration={250}>
          <Tooltip>
            <TooltipTrigger asChild>
              <Button
                variant="outline"
                size="icon"
                onClick={handleToggleTheme}
                aria-label={tooltipLabel}
                className="h-7 w-7 border-[color:var(--ds-border-primary)]"
              >
                {isDark ? <Sun size={13} /> : <Moon size={13} />}
              </Button>
            </TooltipTrigger>
            <TooltipContent side="bottom">{tooltipLabel}</TooltipContent>
          </Tooltip>
        </TooltipProvider>
      </header>

      <main className="flex min-h-0 flex-1 flex-col overflow-hidden p-3">
        <div className="flex min-h-0 flex-1 flex-col overflow-hidden rounded-md border border-[color:var(--ds-border-primary)] bg-[color:var(--ds-surface-primary)]">
          <MarketsGrid
            gridId="{{gridId}}"
            rowData={rows}
            columnDefs={bondColumnDefs}
            defaultColDef={bondDefaultColDef}
            rowIdField="id"
            storage={storage}
            componentName="{{appName}} Blotter"
            {{#each gridPropsLines}}
            {{{this}}}
            {{/each}}
          />
        </div>
      </main>
    </div>
  );
}
