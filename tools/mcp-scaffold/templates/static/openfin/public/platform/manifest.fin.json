{
  "licenseKey": "openfin-demo-license-key",
  "runtime": {
    "arguments": "--enable-mesh --security-realm=react-workspace-starter --remote-debugging-port=9090",
    "version": "43.142.101.2"
  },
  "$comment-devtools": "devtools_port + --remote-debugging-port together expose the OpenFin runtime to Chrome DevTools. Open chrome://inspect#devices in a separate Chrome window and click 'Configure...' → add 'localhost:9090', then SharedWorkers (data-services) appear under 'Other'. See docs/DEBUGGING_SHARED_WORKER.md.",
  "devtools_port": 9090,
  "platform": {
    "uuid": "react-workspace-starter",
    "icon": "http://localhost:5174/dock-provider.png",
    "autoShow": false,
    "providerUrl": "http://localhost:5174/platform/provider",
    "preventQuitOnLastWindowClosed": true
  },
  "shortcut": {
    "company": "OpenFin",
    "description": "A way of showing examples of what OpenFin can do.",
    "icon": "http://localhost:5174/favicon.ico",
    "name": "React Workspace Starter",
    "target": ["desktop", "start-menu"]
  },
  "supportInformation": {
    "company": "OpenFin",
    "product": "Workspace Starter - React Workspace Starter",
    "email": "support@openfin.co",
    "forwardErrorReports": true
  },
  "customSettings": {
    "appId": "markets-ui-react-reference",
    "userId": "dev1",
    "seedConfigUrl": "http://localhost:5174/seed-config.json",
    "$comment-useRest": "Master switch for REST mode. true + non-empty configServiceRestUrl → every ConfigManager in the platform (Provider + main-thread bundle + SharedWorker hub) writes to the REST server first, mirrors to Dexie, queues pendingSync on transient failures. false (or unset) → local Dexie only, even if the URL stays configured. Flip this single boolean to switch the whole platform between local and REST.",
    "useRest": false,
    "configServiceRestUrl": "http://localhost:3001/api/v1",
    "apps": [
      {
        "appId": "react-view1",
        "name": "react-view1",
        "title": "React View 1",
        "description": "Display the React View 1",
        "manifest": "http://localhost:5174/views/view1.fin.json",
        "manifestType": "view",
        "icons": [
          {
            "src": "http://localhost:5174/favicon.ico"
          }
        ],
        "contactEmail": "contact@example.com",
        "supportEmail": "support@example.com",
        "publisher": "OpenFin",
        "intents": [],
        "images": [],
        "tags": ["view", "openfin"]
      },
      {
        "appId": "react-view2",
        "name": "react-view2",
        "title": "React View 2",
        "description": "Display the React View 2",
        "manifest": "http://localhost:5174/views/view2.fin.json",
        "manifestType": "view",
        "icons": [
          {
            "src": "http://localhost:5174/favicon.ico"
          }
        ],
        "contactEmail": "contact@example.com",
        "supportEmail": "support@example.com",
        "publisher": "OpenFin",
        "intents": [],
        "images": [],
        "tags": ["view", "openfin"]
      }
    ]
  }
}
