node_modules/
dist/
*.tsbuildinfo
.vite/
.turbo/

# Lockfiles are not committed — they pin registry.npmjs.org, which a client site
# behind a corporate Artifactory cannot reach. Each environment regenerates its
# own on `npm install`. Reproducibility rests on the version pins in
# package.json. Use `npm install`, never `npm ci`.
package-lock.json

# Playwright
test-results/
playwright-report/
blob-report/

# Vendored member tarballs — copied out of the platform checkout by
# scripts/setup.mjs with the version stripped, so the tarball track's pins
# reference this repo and never churn on a version bump.
/vendor/
