# Member tarballs from `npm run pack:npm` — local only, for external consumers
/dist-npm/

/cell-format-toolbar*.html
/toolbar-teal*.html

# The demo apps travel as an ARCHIVE, not as a tracked tree.
#
# `apps/` is demo/reference material — nine consumer apps plus the Playwright
# suites — that changes rarely but made every CI job pay a second full
# `npm install` for a tree nobody ships. It is carried as `apps-demo.zip`
# (with `apps-demo.manifest.txt` beside it, so a PR still shows which demo
# files changed) and extracted on demand:
#
#   npm run apps:unpack   # get the demos back
#   npm run apps:pack     # after changing them — runs their coverage gate first
#   npm run apps:check    # did I forget to pack? (part of `lint:all`)
#
# See docs/APPS_REPO.md. History before the detach is intact in git.
/apps/

# Local dotenv overrides — `.env.example` is the tracked template
.env.local
.env.*.local

# User reference materials (kept locally, not committed)
Markets Design System-latest/
Markets Design System-latest.zip
Markets Design System*.zip
.app-shell-pr-body.md

# Browser screenshots captured during visual review
.tmp-screenshots/

# Active npm registry config (may hold corp Artifactory tokens) — local only.
# `.npmrc.example` IS tracked as the template; the live `.npmrc` is not.
.npmrc
!.npmrc.example

# Lockfiles are NOT committed. They pin a registry host (registry.npmjs.org)
# that client sites behind a corporate Artifactory cannot reach. Each
# environment regenerates its own lock on `npm install` against its registry.
# Reproducibility rests on the version pins in package.json. Tooling uses
# `npm install` (never `npm ci`), so no committed lock is required.
package-lock.json

# Superpowers scratch (brainstorm mockups, SDD ledger)
.superpowers/
dist-npm/

# Generated by scripts/gen-consumer-tsconfig.mjs (build:packages) — points at dist/,
# so it is build output, not source.
/tsconfig.consumer.json

# Merged Sonar LCOV — regenerated by npm run test:coverage
/coverage/
docs/visual-reference/

# Git worktrees (local isolation)
.worktrees/
